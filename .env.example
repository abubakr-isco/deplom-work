# Образец настроек. Скопируйте в .env (или .env.local) и укажите адрес сервера Sandbox Shop API.
# Префикс /sandbox-shop можно не писать — он добавляется автоматически (если написать, тоже сработает).

# Вариант 1: прямые запросы из браузера на сервер (сервер должен разрешать CORS).
# Используется и в dev, и в сборке (npm run build).
VITE_API_ORIGIN=https://api.wepro.uz

# Вариант 2: прокси Vite (dev и preview) — браузер обращается к /sandbox-shop на адресе сайта,
# а Vite пересылает запросы на сервер. Используется, только если VITE_API_ORIGIN пустой.
API_PROXY_TARGET=
